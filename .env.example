# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lottochu
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_ADMIN_USER_ID=your_telegram_user_id
TELEGRAM_UPDATES_ENABLED=true
LOTTO_PURCHASE_URL=https://ol.dhlottery.co.kr/olotto/game/game645.do
PENSION_PURCHASE_URL=https://el.dhlottery.co.kr/game_mobile/pension720/game.jsp
PURCHASE_REMINDER_ENABLED=true
PURCHASE_MAX_REMINDERS=1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# App
NODE_ENV=development
PORT=3000
